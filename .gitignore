*:Zone.Identifier

# The preset copy is vendored released content: it ships inside
# `webware/webware-tools/presets/` and is re-installed from there, so tracking
# it here would duplicate the dependency rather than hold anything we own.
# Ignored from the repo root because `.specify/.gitignore` is managed by
# `specify` and is overwritten on every integration upgrade.
/.specify/presets/

# Machine-local extension state. The installed extensions themselves are
# tracked under `.specify/extensions/`; only the catalog cache and compiled
# Python bytecode are per-machine.
/.specify/extensions/.cache/
__pycache__/
*.pyc
